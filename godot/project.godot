; Runtime geometry is generated by python3 tools/workflow.py runtime-export.
config_version=5

[application]
config/name="Wayfarer"
run/main_scene="res://scenes/excursion.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; ACI-02: the one player-action registry (references/ACI_PLAN_2026-10-17.md); bindings live in user://wayfarer_controls.cfg.
WfInput="*res://scripts/controls/wf_input.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800

[physics]
; PHYS-001: Jolt, no project gravity or damping (DYN-016, GEN-005); every field comes from the rig's dynamics block.
3d/physics_engine="Jolt Physics"
3d/default_gravity=0.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.05, 1)
anti_aliasing/quality/msaa_3d=2
