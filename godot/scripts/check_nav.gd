extends SceneTree
## PHYS-001 phase 6: the Godot navigation graph (WfNavGraph) against the Python reference crew_dynamics.route() on the same rig.
## The expected paths and techniques below were generated by crew_dynamics.nav/route for these cases (no Python at run time); a null path
## is "no route". Also: a drum that is not synchronized removes the port gates, the casualty query is HOLD, the graph is the rig's.
## godot --headless --path godot --script res://scripts/check_nav.gd   prints one WF_GODOT_NAV line.

const CASES := [
	{"id":"ringA_to_ringB","start":"SECTOR_1_2","goal":"SECTOR_2_3","mode":"COAST","actor":"human_iva","closed":[],"path":["SECTOR_1_2","VESTIBULE_1","TRUNK","VESTIBULE_2","SECTOR_2_3"],"tech":["LADDER_RADIAL","HAND_OVER_HAND","HAND_OVER_HAND","LADDER_RADIAL"]},
	{"id":"ringA_to_ringB_closed","start":"SECTOR_1_2","goal":"SECTOR_2_3","mode":"COAST","actor":"human_iva","closed":["TRUNK-VESTIBULE_2"],"path":null,"tech":null},
	{"id":"sector_to_refuge","start":"SECTOR_1_1","goal":"REFUGE","mode":"COAST","actor":"human_iva","closed":[],"path":["SECTOR_1_1","VESTIBULE_1","TRUNK","REFUGE"],"tech":["LADDER_RADIAL","HAND_OVER_HAND","HAND_OVER_HAND"]},
	{"id":"sector_to_refuge_closed","start":"SECTOR_1_1","goal":"REFUGE","mode":"COAST","actor":"human_iva","closed":["TRUNK-VESTIBULE_1"],"path":null,"tech":null},
	{"id":"refuge_hatch_closed","start":"TRUNK","goal":"REFUGE","mode":"COAST","actor":"human_iva","closed":["TRUNK-REFUGE"],"path":null,"tech":null},
	{"id":"seraph_high_power","start":"SECTOR_2_1","goal":"STOREROOM","mode":"HIGH_POWER","actor":"seraph","closed":[],"path":["SECTOR_2_1","VESTIBULE_2","TRUNK","STOREROOM"],"tech":["LADDER_AFT_DOWN","LADDER_AFT_DOWN","LADDER_AFT_DOWN"]},
	{"id":"suited_off_tubes","start":"TRUNK","goal":"SECTOR_1_1","mode":"COAST","actor":"human_suited","closed":[],"path":null,"tech":null},
	{"id":"suited_eva","start":"SP12","goal":"EVA_EXTERIOR","mode":"EVA","actor":"human_suited","closed":[],"path":["SP12","AIRLOCK_EVA","EVA_EXTERIOR"],"tech":["HAND_OVER_HAND","HAND_OVER_HAND"]},
	{"id":"suited_exterior_coast","start":"SP12","goal":"EVA_EXTERIOR","mode":"COAST","actor":"human_suited","closed":[],"path":null,"tech":null},
	{"id":"iva_exterior","start":"TRUNK","goal":"EVA_EXTERIOR","mode":"EVA","actor":"human_iva","closed":[],"path":null,"tech":null},
	{"id":"suited_eva_airlock_closed","start":"SP12","goal":"EVA_EXTERIOR","mode":"EVA","actor":"human_suited","closed":["SP12-AIRLOCK_EVA"],"path":null,"tech":null},
	{"id":"dock_docked","start":"SECTOR_2_2","goal":"DOCK_PRIMARY","mode":"DOCKED","actor":"human_iva","closed":[],"path":["SECTOR_2_2","VESTIBULE_2","TRUNK","DOCK_PRIMARY"],"tech":["HAND_OVER_HAND","HAND_OVER_HAND","HAND_OVER_HAND"]},
	{"id":"dock_coast","start":"TRUNK","goal":"DOCK_PRIMARY","mode":"COAST","actor":"human_iva","closed":[],"path":null,"tech":null},
	{"id":"dock_service_dock_closed","start":"TRUNK","goal":"DOCK_SERVICE","mode":"DOCKED","actor":"seraph","closed":["TRUNK-DOCK_SERVICE"],"path":null,"tech":null},
	{"id":"same_node","start":"TRUNK","goal":"TRUNK","mode":"COAST","actor":"human_iva","closed":[],"path":["TRUNK"],"tech":[]},
	{"id":"unknown_node","start":"TRUNK","goal":"NOWHERE","mode":"COAST","actor":"human_iva","closed":[],"path":null,"tech":null},
	{"id":"trunk_to_airlock","start":"REFUGE","goal":"AIRLOCK_EVA","mode":"LOW_THRUST","actor":"human_iva","closed":[],"path":["REFUGE","TRUNK","AIRLOCK_EVA"],"tech":["LADDER_AFT_DOWN","LADDER_AFT_DOWN"]},
]

func _initialize() -> void:
	var rig = JSON.parse_string(FileAccess.get_file_as_string("res://generated/wf_sim_rig.json"))
	var fail := []
	var n := 0
	if rig == null or not rig.has("dynamics"):
		fail.append("rig missing")
	else:
		var g := WfNavGraph.new(rig["dynamics"])
		for c in CASES:
			var r := g.route(c["start"], c["goal"], c["mode"], c["actor"], c["closed"])
			n += 1
			if c["path"] == null:
				if r["status"] != "NO_ROUTE":
					fail.append("%s: expected no route, got %s" % [c["id"], r["path"]])
			elif r["path"] != c["path"] or r["techniques"] != c["tech"]:
				fail.append("%s: got %s %s, expected %s %s" % [c["id"], r["path"], r["techniques"], c["path"], c["tech"]])
		# DYN-009: the port gate needs a synchronized drum; the rest of the ship is unaffected
		var gated := g.route("SECTOR_1_1", "REFUGE", "COAST", "human_iva", [], false)
		if gated["status"] != "NO_ROUTE":
			fail.append("unsynchronized port gate did not remove the route")
		if g.route("TRUNK", "REFUGE", "COAST", "human_iva", [], false)["path"] != ["TRUNK", "REFUGE"]:
			fail.append("unsynchronized drum removed a spine route")
		n += 2
		var cas := g.casualty("SECTOR_1_1", "REFUGE", "COAST", "human_iva")
		if cas["status"] != "HOLD" or cas["source"] != "DYN-020" or cas.has("path"):
			fail.append("casualty query is not HOLD / DYN-020: %s" % [cas])
		n += 1
		if g.edges.size() != rig["dynamics"]["nav"]["edges"].size() or g.edges.size() < 10:
			fail.append("graph is not the rig's")
	print("WF_GODOT_NAV " + JSON.stringify({"result": "PASS" if fail.is_empty() else "FAIL", "cases": n, "reference": "crew_dynamics.route", "status": "PROTOTYPE", "fail": fail}))
	quit(0 if fail.is_empty() else 1)
