# Git tracks text, evidence and baselines. Blender files, renders and run
# directories are regenerated by the pipeline and stay out.
__pycache__/
*.pyc
*.blend
*.blend[0-9]*
**/milestones/
renders/*
!renders/.gitkeep
runs/
.venv/
.wayfarer-write.lock
.wayfarer-stages.json
.claude/settings.local.json
godot/.godot/
godot/generated/
CLAUDE.local.md
# Maintainer-local: Drive workbook captures, owner correspondence and internal review notes are never published.
references/drive_capture_*/
references/OWNER_*
references/*.md
