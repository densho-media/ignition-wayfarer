   "kb_alpha": [
    "UNMEASURED",
    "SDC counts grains above ~0.6 um only; the index above ~10 um is a collisional-cascade assumption (Dohnanyi 0.83); a flat 0.70 index has no measurement behind it"
   ],
   "kb_mmax": [
    "UNMEASURED",
    "no detector has sampled Kuiper-belt dust heavier than ~1e-11 kg; a 1 g ceiling is a stress assumption"
   ],
   "isd_rho": [
    "MEASURED-MODEL",
    "interstellar dust mass density 2.1e-24 (Kruger & Strub 2015, Ulysses) to 6.2e-24 kg/m3 (Frisch et al. 1999 from gas depletion); the upper value is literature"
   ],
   "isd_tail": [
    "DISPUTED",
    "EXTRAPOLATED = the Landgraf 2000 upper bound of the in-situ distribution; RADAR = the AMOR hyperbolic-meteor flux (Baggaley 2000), which later radar surveys (CMOR, Musci 2012; review Hajdukova 2019) did not confirm"
   ],
   "K_CRATER": [
    "EXTRAPOLATION",
